# Copy this file to .env.local and fill with your Firebase project values
# Then restart the dev server (`npm run dev`).

VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
# Optional:
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXX

# Notes:
# 1) Enable Anonymous sign-in in Firebase Console -> Authentication -> Sign-in method
# 2) Ensure Firestore is enabled and rules allow your dev access
# 3) After filling .env.local, restart the dev server and open http://localhost:5175

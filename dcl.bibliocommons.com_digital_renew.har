tsSuspendHold\":false,\"maintainsBorrowingHistoryOnDisable\":false,\"quickStartUrl\":null,\"showFormatDuringCheckout\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"supportsSuspendHoldEndDateEdit\":true,\"supportsCancelledExpiredHolds\":true,\"healthy\":true}},\"availability\":{\"circulationType\":\"REQUEST\",\"onOrderCopies\":0,\"localisedStatus\":\"UNAVAILABLE\",\"heldCopies\":0,\"eresourceDescription\":null,\"singleBranch\":false,\"metadataId\":\"S114C1554503\",\"availabilityLocationType\":\"NA\",\"statusType\":\"UNAVAILABLE\",\"status\":\"UNAVAILABLE\",\"bibType\":\"PHYSICAL\",\"volumesCount\":0,\"totalCopies\":1,\"libraryUseOnly\":false,\"eresourceUrl\":null,\"availableCopies\":0}},\"S114C1787737\":{\"id\":\"S114C1787737\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"cissp_for_dummies�miller_lawrence_c�text_eng\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"genreForm\":[\"Study Guides\",\"Study guides\"],\"callNumber\":\"005.8 MIL\",\"authors\":[\"Miller, Lawrence C.\"],\"metadataId\":\"S114C1787737\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9781394261772/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9781394261772/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9781394261772/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"multiscriptAuthor\":null,\"audiences\":[\"ADULT\"],\"consumptionFormat\":\"READ\",\"contentType\":\"NONFICTION\",\"multiscriptTitle\":null,\"compositeSubjectHeadings\":[\"Electronic Data Processing Personnel -- Certification\",\"Computer Networks -- Examinations -- Study Guides\",\"Computer Security -- Examinations -- Study Guides\",\"Study Guides\"],\"series\":[{\"name\":\"--For dummies\",\"volume\":null,\"sortName\":\"--for dummies\",\"volumeNumber\":null}],\"format\":\"BK\",\"subtitle\":\"\",\"title\":\"CISSP for Dummies\",\"primaryLanguage\":\"eng\",\"publicationDate\":\"2024\",\"id\":\"S114C1787737\",\"description\":\"\\\"Fully revised for the April 2024 CBK, this book is your key to succeeding on the CISSP exam. You'll learn everything you need to know about the popular ISC2 certification test, so you can head into test day with confidence. Get comfortable with each of the 8 test domains, prepare with a 60-day study plan, and work through practice questions that will help you master the material. You'll get tips and advice for passing this milestone in your cybersecurity career, plus digital flashcards and practice questions online.\\\"-- Back cover.\",\"isbns\":[\"9781394261772\",\"1394261772\"],\"rating\":{},\"subjectHeadings\":[\"Electronic data processing personnel Certification\",\"Computer networks Examinations Study guides\",\"Computer security Examinations Study guides\"],\"edition\":\"8th edition\"},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":true,\"materialPolicy\":{\"requiresDuration\":false,\"supportsSuspendHoldStartDateEdit\":false,\"supportsBatchVolumeHolds\":true,\"requiresFormatDuringHold\":false,\"supportsBorrowingHistory\":false,\"borrowingHistorySupportsReturnedDates\":true,\"showQuickstartLink\":false,\"supportsDownload\":false,\"requiresFormatDuringCheckout\":false,\"requiresEmailDuringHold\":false,\"helpUrl\":null,\"externalAPI\":false,\"itemLevelHoldsPredetermined\":false,\"showFormatDuringHold\":false,\"supportsSuspendHold\":false,\"maintainsBorrowingHistoryOnDisable\":false,\"quickStartUrl\":null,\"showFormatDuringCheckout\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"supportsSuspendHoldEndDateEdit\":true,\"supportsCancelledExpiredHolds\":true,\"healthy\":true}},\"availability\":{\"circulationType\":\"REQUEST\",\"onOrderCopies\":0,\"localisedStatus\":\"AVAILABLE_IN_BRANCH\",\"heldCopies\":0,\"eresourceDescription\":null,\"singleBranch\":false,\"metadataId\":\"S114C1787737\",\"availabilityLocationType\":\"OTHER\",\"statusType\":\"AVAILABLE\",\"status\":\"AVAILABLE\",\"bibType\":\"PHYSICAL\",\"volumesCount\":0,\"totalCopies\":3,\"libraryUseOnly\":false,\"eresourceUrl\":null,\"availableCopies\":1}},\"S114C1794755\":{\"id\":\"S114C1794755\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"microsoft_copilot_pro_step_by_step�crosbie_lisa�text_eng\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"genreForm\":[],\"callNumber\":\"005.446 CRO\",\"authors\":[\"Crosbie, Lisa\"],\"metadataId\":\"S114C1794755\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9780135369425/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9780135369425/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9780135369425/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"multiscriptAuthor\":null,\"audiences\":[\"ADULT\"],\"consumptionFormat\":\"READ\",\"contentType\":\"NONFICTION\",\"multiscriptTitle\":null,\"compositeSubjectHeadings\":[\"Microsoft Windows (Computer File)\",\"Microsoft Office\",\"Natural Language Processing (Computer Science)\",\"Artificial Intelligence\",\"Chatbots\",\"Business -- Computer Programs\"],\"series\":[{\"name\":\"Step by step\",\"volume\":null,\"sortName\":\"step by step\",\"volumeNumber\":null}],\"format\":\"BK\",\"subtitle\":\"Step by Step\",\"title\":\"Microsoft Copilot Pro\",\"primaryLanguage\":\"eng\",\"publicationDate\":\"2025\",\"id\":\"S114C1794755\",\"description\":\"Copilot Pro enables you to be more creative and productive, but using generative AI requires a whole new way of thinking most users try once or twice, get poor results and give up. This book teaches them what they don't know and helps them get started with the right skills. Copilot Pro adds generative AI experiences into the most used Microsoft applications, Outlook, Word, PowerPoint, Excel, and OneNote, enabling users to be more productive and creative by generating first drafts, editing and improving their work, easily understanding and finding pieces of information in large documents, and gaining new insights. It also allows users to generate text and images in a browser and via a mobile app, using the latest AI models. This is a completely new way of thinking and workinglike having your own personal \\\"enthusiastic intern\\\" working side by side with you every day to take on the mundane and time-consuming tasks, freeing you up for more interesting and creative work. Generative AI has been everywhere in the media, with a huge hype cycle, but most everyday workers don't understand how it can be applied to their day-to-day work in a practical and transformative way.\",\"isbns\":[\"9780135369425\",\"0135369428\"],\"rating\":{},\"subjectHeadings\":[\"Microsoft Windows (Computer file)\",\"Microsoft Office\",\"Natural language processing (Computer science)\",\"Artificial intelligence\",\"Chatbots\",\"Business Computer programs\"],\"edition\":null},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":true,\"materialPolicy\":{\"requiresDuration\":false,\"supportsSuspendHoldStartDateEdit\":false,\"supportsBatchVolumeHolds\":true,\"requiresFormatDuringHold\":false,\"supportsBorrowingHistory\":false,\"borrowingHistorySupportsReturnedDates\":true,\"showQuickstartLink\":false,\"supportsDownload\":false,\"requiresFormatDuringCheckout\":false,\"requiresEmailDuringHold\":false,\"helpUrl\":null,\"externalAPI\":false,\"itemLevelHoldsPredetermined\":false,\"showFormatDuringHold\":false,\"supportsSuspendHold\":false,\"maintainsBorrowingHistoryOnDisable\":false,\"quickStartUrl\":null,\"showFormatDuringCheckout\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"supportsSuspendHoldEndDateEdit\":true,\"supportsCancelledExpiredHolds\":true,\"healthy\":true}},\"availability\":{\"circulationType\":\"REQUEST\",\"onOrderCopies\":0,\"localisedStatus\":\"AVAILABLE_IN_BRANCH\",\"heldCopies\":0,\"eresourceDescription\":null,\"singleBranch\":false,\"metadataId\":\"S114C1794755\",\"availabilityLocationType\":\"OTHER\",\"statusType\":\"AVAILABLE\",\"status\":\"AVAILABLE\",\"bibType\":\"PHYSICAL\",\"volumesCount\":0,\"totalCopies\":4,\"libraryUseOnly\":false,\"eresourceUrl\":null,\"availableCopies\":1}},\"S114C1671468\":{\"id\":\"S114C1671468\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"money_from_nothing_or_why_we_should_stop_worrying_about_debt_and_learn_to_love_the_federal_reserve�hockett_robert�text_eng\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"genreForm\":[],\"callNumber\":\"330 HOC\",\"authors\":[\"Hockett, Robert\"],\"metadataId\":\"S114C1671468\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9781612198569/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9781612198569/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9781612198569/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"multiscriptAuthor\":null,\"audiences\":[\"ADULT\"],\"consumptionFormat\":\"READ\",\"contentType\":\"NONFICTION\",\"multiscriptTitle\":null,\"compositeSubjectHeadings\":[\"Federal Reserve Banks\",\"Monetary Policy -- United States\",\"Economics -- United States\"],\"series\":[],\"format\":\"BK\",\"subtitle\":\"Or, Why We Should Stop Worrying About Debt and Learn to Love the Federal Reserve\",\"title\":\"Money From Nothing\",\"primaryLanguage\":\"eng\",\"publicationDate\":\"2020\",\"id\":\"S114C1671468\",\"description\":\"\\\"When the government decides to spend money, it simply creates the necessary funds for itself - as if out of thin air. That's how we pay for interstate highways, post offices, wars, social services, and economic stimulus packages. If it's that easy to make money...can't we all get more of it? Absolutely. And we should. So argue financial regulation expert Robert Hockett and best-selling philosopher Aaron James in this eye-opening, irreverent, and inspiring exploration of what the dollar really is. And better still, they show how we can build an economy that works for everybody without unwanted taxes and added regulations. In the process, we learn how disingenuous the political rhetoric surrounding inflation can be, how the demonized concept of the deficit is really just another way of tallying our collective national wealth, and how a strong central bank could free us from the abuses of private banking. With broad historical background and ambitious yet practical institutional proposals, Hockett and James offer a new vision of public finance - people's banking for a people's economy. Armed with this new outlook, we can even stop worrying debt and learn to love a strong, accountable, and transparent Federal Reserve as a cornerstone of our democracy.\\\"--Amazon.\",\"isbns\":[\"9781612198569\",\"1612198562\"],\"rating\":{},\"subjectHeadings\":[\"Federal Reserve banks\",\"Monetary policy United States\",\"Economics United States\"],\"edition\":null},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":false,\"materialPolicy\":{\"requiresDuration\":false,\"supportsSuspendHoldStartDateEdit\":false,\"supportsBatchVolumeHolds\":true,\"requiresFormatDuringHold\":false,\"supportsBorrowingHistory\":false,\"borrowingHistorySupportsReturnedDates\":true,\"showQuickstartLink\":false,\"supportsDownload\":false,\"requiresFormatDuringCheckout\":false,\"requiresEmailDuringHold\":false,\"helpUrl\":null,\"externalAPI\":false,\"itemLevelHoldsPredetermined\":false,\"showFormatDuringHold\":false,\"supportsSuspendHold\":false,\"maintainsBorrowingHistoryOnDisable\":false,\"quickStartUrl\":null,\"showFormatDuringCheckout\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"supportsSuspendHoldEndDateEdit\":true,\"supportsCancelledExpiredHolds\":true,\"healthy\":true}},\"availability\":{\"circulationType\":\"REQUEST\",\"onOrderCopies\":0,\"localisedStatus\":\"AVAILABLE_IN_BRANCH\",\"heldCopies\":0,\"eresourceDescription\":null,\"singleBranch\":false,\"metadataId\":\"S114C1671468\",\"availabilityLocationType\":\"OTHER\",\"statusType\":\"AVAILABLE\",\"status\":\"AVAILABLE\",\"bibType\":\"PHYSICAL\",\"volumesCount\":0,\"totalCopies\":2,\"libraryUseOnly\":false,\"eresourceUrl\":null,\"availableCopies\":1}},\"S114C1730913\":{\"id\":\"S114C1730913\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"parenting_with_an_accent_how_immigrants_honor_their_heritage_navigate_setbacks_and_chart_new_paths_f�rumer_masha�text_eng\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"genreForm\":[\"Cross-cultural Studies\"],\"callNumber\":\"306.874097 RUM\",\"authors\":[\"Rumer, Masha\"],\"metadataId\":\"S114C1730913\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9780807021873/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9780807021873/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9780807021873/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"multiscriptAuthor\":null,\"audiences\":[\"ADULT\"],\"consumptionFormat\":\"READ\",\"contentType\":\"NONFICTION\",\"multiscriptTitle\":null,\"compositeSubjectHeadings\":[\"Parenthood -- United States -- Cross-cultural Studies\",\"Children of Immigrants -- United States\",\"Immigrants -- Family Relationships -- United States\",\"Immigrant Families -- United States\"],\"series\":[],\"format\":\"BK\",\"subtitle\":\"How Immigrants Honor Their Heritage, Navigate Setbacks, and Chart New Paths for Their Children\",\"title\":\"Parenting With An Accent\",\"primaryLanguage\":\"eng\",\"publicationDate\":\"2022\",\"id\":\"S114C1730913\",\"description\":\"\\\"A candid portrait of the realities, challenges, and joys many contemporary immigrants confront while raising a new generation of 
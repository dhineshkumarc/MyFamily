:\"https://secure.syndetics.com/index.aspx?isbn=9781484238516/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9781484238516/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9781484238516/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"isbns\":[\"9781484238516\",\"1484238516\"],\"primaryLanguage\":\"eng\",\"series\":[],\"edition\":\"Third edition\",\"multiscriptTitle\":null,\"multiscriptAuthor\":null,\"contentType\":\"NONFICTION\",\"audiences\":[\"ADULT\"],\"compositeSubjectHeadings\":[\"Computer Security\",\"Firewalls (Computer Security)\",\"COMPUTERS -- Security -- General\"],\"groupKey\":\"firewalls_don_t_stop_dragons_a_step_by_step_guide_to_computer_security_for_non_techies�parker_carey�text_eng\",\"id\":\"S114C1554468\",\"rating\":{\"averageRating\":100,\"totalCount\":1}},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":false,\"materialPolicy\":{\"supportsBatchVolumeHolds\":true,\"itemLevelHoldsPredetermined\":false,\"requiresDuration\":false,\"requiresEmailDuringHold\":false,\"requiresFormatDuringHold\":false,\"requiresFormatDuringCheckout\":false,\"supportsDownload\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"showFormatDuringHold\":false,\"showFormatDuringCheckout\":false,\"supportsSuspendHold\":false,\"supportsSuspendHoldStartDateEdit\":false,\"supportsSuspendHoldEndDateEdit\":true,\"showQuickstartLink\":false,\"supportsBorrowingHistory\":false,\"borrowingHistorySupportsReturnedDates\":true,\"maintainsBorrowingHistoryOnDisable\":false,\"supportsCancelledExpiredHolds\":true,\"helpUrl\":null,\"quickStartUrl\":null,\"healthy\":true,\"externalAPI\":false}},\"availability\":{\"metadataId\":\"S114C1554468\",\"bibType\":\"PHYSICAL\",\"availabilityLocationType\":\"NA\",\"status\":\"UNAVAILABLE\",\"circulationType\":\"REQUEST\",\"libraryUseOnly\":false,\"heldCopies\":0,\"available
ownloadUrl\":null,\"metadataId\":\"S114C1312885\",\"thirdPartyReaderUrl\":null,\"status\":\"OUT\",\"digitalId\":null,\"checkInEnabled\":false,\"copy\":null,\"format\":null,\"fines\":0,\"volume\":null,\"actions\":[\"renew\",\"updateFormat\"],\"bibTitle\":\"The Downsized Veggie Garden\"},\"-9050883889811980946\":{\"checkoutId\":\"-9050883889811980946\",\"materialType\":\"PHYSICAL\",\"branch\":{\"code\":\"PA\",\"name\":\"Parker\",\"ips\":[]},\"downloadable\":false,\"dueDate\":\"2026-04-25\",\"timesRenewed\":7,\"downloadUrl\":null,\"metadataId\":\"S114C1788468\",\"thirdPartyReaderUrl\":null,\"status\":\"OUT\",\"digitalId\":null,\"checkInEnabled\":false,\"copy\":null,\"format\":null,\"fines\":0,\"volume\":null,\"actions\":[\"renew\",\"updateFormat\"],\"bibTitle\":\"Mastering AI\"}},\"holdings\":{},\"ugc\":{\"ratings\":{}},\"eventSeries\":{},\"catalogBibs\":{},\"excerpts\":{},\"eventRegistration\":{},\"holds\":{},\"eventAudiences\":{},\"lists\":{},\"ignoredUsers\":{},\"specialHours\":{},\"subscriptions\":{},\"facilityTypes\":{},\"authorNotes\":{},\"images\":{},\"bibs\":{\"S114C1807982\":{\"id\":\"S114C1807982\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"ai_for_life_100_ways_to_use_artificial_intelligence_to_make_your_life_easier_more_productive_and_mor�quillian_celia�text_eng\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"genreForm\":[],\"callNumber\":\"006.3 QUI\",\"authors\":[\"Quillian, Celia\"],\"metadataId\":\"S114C1807982\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9781507223390/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9781507223390/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9781507223390/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"multiscriptAuthor\":null,\"audiences\":[\"ADULT\"],\"consumptionFormat\":\"READ\",\"contentType\":\"NONFICTION\",\"multiscriptTitle\":null,\"compositeSubjectHeadings\":[\"Artificial Intelligence\",\"Artificial Intelligence -- Data Processing\"],\"series\":[],\"format\":\"BK\",\"subtitle\":\"100+ Ways to Use Artificial Intelligence to Make your Life Easier, More Productive ... and More Fun!\",\"title\":\"AI for Life\",\"primaryLanguage\":\"eng\",\"publicationDate\":\"2025\",\"id\":\"S114C1807982\",\"description\":\"\\\"Every day, it seems like there's a new AI tool on the market and a new, complicated way to use it. But what if you could use AI to make your life easier without the complications? In AI for Life, AI expert and creator of @SmartWorkAI offers over 100 ideas and ready-to-use prompts to get AI beginners started using the technology to actually improve their lives. Beginning with a primer on the basics-including an overview of the popular and free AI tools-you will learn expert-tested tips and tricks to get the most out of your AI use, such as layering prompts to dive deeper into an initial response or asking for the output in different formats. Packed with practical how-to information, AI for Life is the must-have guide for using generative AI to make life easier, more productive, more organized, and more fun!\\\"-- Provided by publisher.\",\"isbns\":[\"9781507223390\",\"9781507223406\"],\"rating\":{\"averageRating\":54,\"totalCount\":10},\"subjectHeadings\":[\"Artificial intelligence\",\"Artificial intelligence Data processing\"],\"edition\":\"First Adams Media trade paperback edition\"},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":true,\"materialPolicy\":{\"requiresDuration\":false,\"supportsSuspendHoldStartDateEdit\":false,\"supportsBatchVolumeHolds\":true,\"requiresFormatDuringHold\":false,\"supportsBorrowingHistory\":false,\"borrowingHistorySupportsReturnedDates\":true,\"showQuickstartLink\":false,\"supportsDownload\":false,\"requiresFormatDuringCheckout\":false,\"requiresEmailDuringHold\":false,\"helpUrl\":null,\"externalAPI\":false,\"itemLevelHoldsPredetermined\":false,\"showFormatDuringHold\":false,\"supportsSuspendHold\":false,\"maintainsBorrowingHistoryOnDisable\":false,\"quickStartUrl\":null,\"showFormatDuringCheckout\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"supportsSuspendHoldEndDateEdit\":true,\"supportsCancelledExpiredHolds\":true,\"healthy\":true}},\"availability\":{\"circulationType\":\"REQUEST\",\"onOrderCopies\":0,\"localisedStatus\":\"UNAVAILABLE\",\"heldCopies\":0,\"eresourceDescription\":null,\"singleBranch\":false,\"metadataId\":\"S114C1807982\",\"availabilityLocationType\":\"NA\",\"statusType\":\"UNAVAILABLE\",\"status\":\"UNAVAILABLE\",\"bibType\":\"PHYSICAL\",\"volumesCount\":0,\"totalCopies\":3,\"libraryUseOnly\":false,\"eresourceUrl\":null,\"availableCopies\":0}},\"S114C1748420\":{\"id\":\"S114C1748420\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"learning_korean_learn_to_speak_read_and_write_korean_quickly�damron_julie�text_eng\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"genreForm\":[\"Textbooks-for English speakers\",\"Textbooks for Foreign Speakers\",\"Textbooks\"],\"callNumber\":\"495.7 DAM\",\"authors\":[\"Damron, Julie\"],\"metadataId\":\"S114C1748420\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9780804853323/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9780804853323/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9780804853323/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"multiscriptAuthor\":null,\"audiences\":[\"ADULT\"],\"consumptionFormat\":\"READ\",\"contentType\":\"NONFICTION\",\"multiscriptTitle\":null,\"compositeSubjectHeadings\":[\"Korean Language -- Spoken Korean\",\"Korean Language -- Textbooks for Foreign Speakers -- English\",\"Textbooks -- for English Speakers\"],\"series\":[{\"name\":\"A language guide for beginners\",\"volume\":null,\"sortName\":\"language guide for beginners\",\"volumeNumber\":null}],\"format\":\"BK\",\"subtitle\":\"Learn to Speak, Read and Write Korean Quickly!\",\"title\":\"Learning Korean\",\"primaryLanguage\":\"eng\",\"publicationDate\":\"2022\",\"id\":\"S114C1748420\",\"description\":\"Learning Korean teaches you the basics of the Korean language, including practical daily conversations and vocabulary, and enables you to begin communicating effectively right away. All Korean words and sentences are given in Korean Hangeul script and romanized form for easy pronunciation, with English translations.\",\"isbns\":[\"9780804853323\",\"0804853320\"],\"rating\":{},\"subjectHeadings\":[\"Korean language Spoken Korean\",\"Korean language Textbooks for foreign speakers English\"],\"edition\":\"First edition\"},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":true,\"materialPolicy\":{\"requiresDuration\":false,\"supportsSuspendHoldStartDateEdit\":false,\"supportsBatchVolumeHolds\":true,\"requiresFormatDuringHold\":false,\"supportsBorrowingHistory\":false,\"borrowingHistorySupportsReturnedDates\":true,\"showQuickstartLink\":false,\"supportsDownload\":false,\"requiresFormatDuringCheckout\":false,\"requiresEmailDuringHold\":false,\"helpUrl\":null,\"externalAPI\":false,\"itemLevelHoldsPredetermined\":false,\"showFormatDuringHold\":false,\"supportsSuspendHold\":false,\"maintainsBorrowingHistoryOnDisable\":false,\"quickStartUrl\":null,\"showFormatDuringCheckout\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"supportsSuspendHoldEndDateEdit\":true,\"supportsCancelledExpiredHolds\":true,\"healthy\":true}},\"availability\":{\"circulationType\":\"REQUEST\",\"onOrderCopies\":0,\"localisedStatus\":\"AVAILABLE_IN_BRANCH\",\"heldCopies\":0,\"eresourceDescription\":null,\"singleBranch\":false,\"metadataId\":\"S114C1748420\",\"availabilityLocationType\":\"OTHER\",\"statusType\":\"AVAILABLE\",\"status\":\"AVAILABLE\",\"bibType\":\"PHYSICAL\",\"volumesCount\":0,\"totalCopies\":4,\"libraryUseOnly\":false,\"eresourceUrl\":null,\"availableCopies\":3}},\"S114C1728768\":{\"id\":\"S114C1728768\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"cloud_security_for_dummies�coombs_ted�text_eng\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"genreForm\":[],\"callNumber\":\"004.6782 COO\",\"authors\":[\"Coombs, Ted\"],\"metadataId\":\"S114C1728768\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9781119790464/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9781119790464/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9781119790464/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"multiscriptAuthor\":null,\"audiences\":[\"ADULT\"],\"consumptionFormat\":\"READ\",\"contentType\":\"NONFICTION\",\"multiscriptTitle\":null,\"compositeSubjectHeadings\":[\"Cloud Computing -- Security Measures\",\"Computer Networks -- Security Measures\",\"Computer Security\"],\"series\":[{\"name\":\"--For dummies\",\"volume\":null,\"sortName\":\"--for dummies\",\"volumeNumber\":null}],\"format\":\"BK\",\"subtitle\":\"\",\"title\":\"Cloud Security for Dummies\",\"primaryLanguage\":\"eng\",\"publicationDate\":\"2022\",\"id\":\"S114C1728768\",\"description\":\"Cloud technology has changed the way we approach technology. It's also given rise to a new set of security challenges caused by bad actors who seek to exploit vulnerabilities in a digital infrastructure. You can put the kibosh on these hackers and their dirty deeds by hardening the walls that protect your data.\",\"isbns\":[\"9781119790464\",\"1119790468\"],\"rating\":{},\"subjectHeadings\":[\"Cloud computing Security measures\",\"Computer networks Security measures\",\"Computer security\"],\"edition\":null},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":true,\"materialPolicy\":{\"requiresDuration\":false,\"supportsSuspendHoldStartDateEdit\":false,\"supportsBatchVolumeHolds\":true,\"requiresFormatDuringHold\":false,\"supportsBorrowingHistory\":false,\"borrowingHistorySupportsReturnedDates\":true,\"showQuickstartLink\":false,\"supportsDownload\":false,\"requiresFormatDuringCheckout\":false,\"requiresEmailDuringHold\":false,\"helpUrl\":null,\"externalAPI\":false,\"itemLevelHoldsPredetermined\":false,\"showFormatDuringHold\":false,\"supportsSuspendHold\":false,\"maintainsBorrowingHistoryOnDisable\":false,\"quickStartUrl\":null,\"showFormatDuringCheckout\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"supportsSuspendHoldEndDateEdit\":true,\"supportsCancelledExpiredHolds\":true,\"healthy\":true}},\"availability\":{\"circulationType\":\"REQUEST\",\"onOrderCopies\":0,\"localisedStatus\":\"UNAVAILABLE\",\"heldCopies\":0,\"eresourceDescription\":null,\"singleBranch\":false,\"metadataId\":\"S114C1728768\",\"availabilityLocationType\":\"NA\",\"statusType\":\"UNAVAILABLE\",\"status\":\"UNAVAILABLE\",\"bibType\":\"PHYSICAL\",\"volumesCount\":0,\"totalCopies\":4,\"libraryUseOnly\":false,\"eresourceUrl\":null,\"availableCopies\":0}},\"S114C1788468\":{\"id\":\"S114C1788468\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"mastering_ai_a_survival_guide_to_our_superpowered_future�kahn_jeremy�text_eng\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"genreForm\":[],\"callNumber\":\"006.3 KAH\",\"authors\":[\"Kahn, Jeremy\"],\"metadataId\":\"S114C1788468\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9781668053324/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9781668053324/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9781668053324/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"multiscriptAuthor\":null,\"audiences\":[\"ADULT\"],\"consumptionFormat\":\"READ\",\"contentType\":\"NONFICTION\",\"multiscriptTitle\":null,\"compositeSubjectHeadings\":[\"Artificial Intelligence\",\"Artificial Intelligence -- Social Aspects\",\"Artificial Intelligence -- Political Aspects\",\"Artificial Intelligence -- Forecasting\"],\"series\":[],\"format\":\"BK\",\"subtitle\":\"A Survival Guide to Our Superpowered Future\",\"title\":\"Mastering AI\",\"primaryLanguage\":\"eng\",\"publicationDate\":\"2024\",\"id\":\"S114C1788468\",\"description\":\"\\\"A Fortune magazine journalist draws on his expertise and extensive contacts among the companies and scientists at the forefront of artificial intelligence to offer dramatic predictions of AI's impact over the next decade, from reshaping our economy and the way we work, learn, and create to unknitting our social fabric, jeopardizing our democracy, and fundamentally altering the way we think. Within the next five years, Jeremy Kahn predicts, AI will disrupt almost every industry and enterprise, with vastly increased efficiency and productivity. It will restructure the workforce, making AI copilots a must for every knowledge worker. It will revamp education, meaning children around the world can have personal, portable tutors. It will revolutionize health care, making individualized, targeted pharmaceuticals more affordable. It will compel us to reimagine how we make art, compose music, and write and publish books. The potential of generative AI to extend our skills, talents, and creativity as humans is undeniably exciting and promising. But while this new technology has a bright future, it also casts a dark and fearful shadow. AI will provoke pervasive, disruptive, potentially devastating knock-on effects. Leveraging his unrivaled access to the leaders, scientists, futurists, and others who are making AI a reality, Kahn will argue that if not carefully designed and vigilantly regulated AI will deepen income inequality, depressing wages while imposing winner-take-all markets across much of the economy. AI risks undermining democracy, as truth is overtaken by misinformation, racial bias, and harmful stereotypes. Continuing a process begun by the internet, AI will rewire our brains, likely inhibiting our ability to think critically, to remember, and even to get along with one another--unless we all take decisive action to prevent this from happening.\\\"-- Publisher's description.\",\"isbns\":[\"9781668053324\",\"1668053322\"],\"rating\":{},\"subjectHeadings\":[\"Artificial intelligence\",\"Artificial intelligence Social aspects\",\"Artificial intelligence Political aspects\",\"Artificial intelligence Forecasting\"],\"edition\":null},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":false,\"materialPolicy\":{\"requiresDuration\":false,\"supportsSuspendHoldStartDateEdit\":false,\"supportsBatchVolumeHolds\":true,\"requiresFormatDuringHold\":false,\"supportsBorrowingHistory\":false,\"borrowingHistorySupportsReturnedDates\":true,\"showQuickstartLink\":false,\"supportsDownload\":false,\"requiresFormatDuringCheckout\":false,\"requiresEmailDuringHold\":false,\"helpUrl\":null,\"externalAPI\":false,\"itemLevelHoldsPredetermined\":false,\"showFormatDuringHold\":false,\"supportsSuspendHold\":false,\"maintainsBorrowingHistoryOnDisable\":false,\"quickStartUrl\":null,\"showFormatDuringCheckout\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"supportsSuspendHoldEndDateEdit\":true,\"supportsCancelledExpiredHolds\":true,\"healthy\":true}},\"availability\":{\"circulationType\":\"REQUEST\",\"onOrderCopies\":0,\"localisedStatus\":\"AVAILABLE_IN_BRANCH\",\"heldCopies\":0,\"eresourceDescription\":null,\"singleBranch\":false,\"metadataId\":\"S114C1788468\",\"availabilityLocationType\":\"OTHER\",\"statusType\":\"AVAILABLE\",\"status\":\"AVAILABLE\",\"bibType\":\"PHYSICAL\",\"volumesCount\":0,\"totalCopies\":4,\"libraryUseOnly\":false,\"eresourceUrl\":null,\"availableCopies\":1}},\"S114C1813549\":{\"id\":\"S114C1813549\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"cybersecurity_tabletop_exercises_from_planning_to_execution�lelewski_robert�text_eng\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"genreForm\":[],\"callNumber\":\"005.8 LEL\",\"authors\":[\"Lelewski, Robert\"],\"metadataId\":\"S114C1813549\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9781718503823/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9781718503823/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9781718503823/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"multiscriptAuthor\":null,\"audiences\":[\"ADULT\"],\"consumptionFormat\":\"READ\",\"contentType\":\"NONFICTION\",\"multiscriptTitle\":null,\"compositeSubjectHeadings\":[\"Computer Security -- Decision Making\",\"Computer Security -- Planning\"],\"series\":[],\"format\":\"BK\",\"subtitle\":\"From Planning to Execution\",\"title\":\"Cybersecurity Tabletop Exercises\",\"primaryLanguage\":\"eng\",\"publicationDate\":\"2025\",\"id\":\"S114C1813549\",\"description\":\"\\\"Provides detailed guidance on how to plan, facilitate, and learn from a cybersecurity tabletop exercise so that members of an organization can coordinate their response to a potential future cybersecurity event or emergency. Includes examples of tabletop exercise scenarios suited to different purposes\\\"-- Provided by publisher.\",\"isbns\":[\"9781718503823\",\"9781718503830\"],\"rating\":{},\"subjectHeadings\":[\"Computer security Decision making\",\"Computer security Planning\"],\"edition\":null},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":false,\"materialPolicy\":{\"requiresDuration\":false,\"supportsSuspendHoldStartDateEdit\":false,\"supportsBatchVolumeHolds\":true,\"requiresFormatDuringHold\":false,\"supportsBorrowingHistory\":false,\"borrowingHistorySupportsReturnedDates\":true,\"showQuickstartLink\":false,\"supportsDownload\":false,\"requiresFormatDuringCheckout\":false,\"requiresEmailDuringHold\":false,\"helpUrl\":null,\"externalAPI\":false,\"itemLevelHoldsPredetermined\":false,\"showFormatDuringHold\":false,\"supportsSuspendHold\":false,\"maintainsBorrowingHistoryOnDisable\":false,\"quickStartUrl\":null,\"showFormatDuringCheckout\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"supportsSuspendHoldEndDateEdit\":true,\"supportsCancelledExpiredHolds\":true,\"healthy\":true}},\"availability\":{\"circulationType\":\"REQUEST\",\"onOrderCopies\":0,\"localisedStatus\":\"UNAVAILABLE\",\"heldCopies\":0,\"eresourceDescription\":null,\"singleBranch\":false,\"metadataId\":\"S114C1813549\",\"availabilityLocationType\":\"NA\",\"statusType\":\"UNAVAILABLE\",\"status\":\"UNAVAILABLE\",\"bibType\":\"PHYSICAL\",\"volumesCount\":0,\"totalCopies\":1,\"libraryUseOnly\":false,\"eresourceUrl\":null,\"availableCopies\":0}},\"S114C1786566\":{\"id\":\"S114C1786566\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"slow_productivity�newport_cal�text_eng\",\"superFormats\":[\"AUDIOBOOKS_SPOKEN_WORD\",\"TALKING_BOOKS\",\"SPECIALTY_FORMATS\"],\"genreForm\":[\"Audiobooks\",\"Playaway\"],\"callNumber\":\"PLWY 331.118 NEW\",\"authors\":[\"Newport, Cal\"],\"metadataId\":\"S114C1786566\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9798822682641/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9798822682641/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9798822682641/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"multiscriptAuthor\":null,\"audiences\":[\"ADULT\"],\"consumptionFormat\":\"LISTEN\",\"contentType\":\"NONFICTION\",\"multiscriptTitle\":null,\"compositeSubjectHeadings\":[\"Labor Productivity\",\"Humanism\",\"Audiobooks\",\"Playaway\"],\"series\":[],\"format\":\"PLAYAWAY_AUDIOBOOK\",\"subtitle\":\"\",\"title\":\"Slow Productivity\",\"primaryLanguage\":\"eng\",\"publicationDate\":\"2024\",\"id\":\"S114C1786566\",\"description\":\"Our current definition of \\\"productivity\\\" is broken. It pushes us to treat busyness as a proxy for useful effort, leading to impossibly lengthy task lists and ceaseless meetings. Were overwhelmed by all we have to do and on the edge of burnout, left to decide between giving into soul-sapping hustle culture or rejecting ambition altogether. But are these really our only choices? Long before the arrival of pinging inboxes and clogged schedules, historys most creative and impactful philosophers, scientists, artists, and writers mastered the art of producing valuable work with staying power. In this timely and provocative book, Cal Newport harnesses the wisdom of these traditional knowledge workers to radically transform our modern jobs. Drawing from deep research on the habits and mindsets of a varied cast of storied thinkers -- from Galileo and Isaac Newton, to Jane Austen and Georgia O'Keefe -- Newport lays out the key principles of \\\"slow productivity,\\\" a more sustainable alternative to the aimless overwhelm that defines our current moment. Combining cultural criticism with systematic pragmatism, Newport deconstructs the absurdities inherent in standard notions of productivity, and then provides step-by-step advice for cultivating a slower, more humane alternative. From the aggressive rethinking of workload management, to introducing seasonal variation, to shifting your performance toward long-term quality, Slow Productivity provides a roadmap for escaping overload and arriving instead at a more timeless approach to pursuing meaningful accomplishment. The world of work is due for a new revolution. Slow productivity is exactly what we need.\",\"isbns\":[\"9798822682641\"],\"rating\":{},\"subjectHeadings\":[\"Labor productivity\",\"Humanism\"],\"edition\":null},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":false,\"materialPolicy\":{\"requiresDuration\":false,\"supportsSuspendHoldStartDateEdit\":false,\"supportsBatchVolumeHolds\":true,\"requiresFormatDuringHold\":false,\"supportsBorrowingHistory\":false,\"borrowingHistorySupportsReturnedDates\":true,\"showQuickstartLink\":false,\"supportsDownload\":false,\"requiresFormatDuringCheckout\":false,\"requiresEmailDuringHold\":false,\"helpUrl\":null,\"externalAPI\":false,\"itemLevelHoldsPredetermined\":false,\"showFormatDuringHold\":false,\"supportsSuspendHold\":false,\"maintainsBorrowingHistoryOnDisable\":false,\"quickStartUrl\":null,\"showFormatDuringCheckout\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"supportsSuspendHoldEndDateEdit\":true,\"supportsCancelledExpiredHolds\":true,\"healthy\":true}},\"availability\":{\"circulationType\":\"REQUEST\",\"onOrderCopies\":0,\"localisedStatus\":\"UNAVAILABLE\",\"heldCopies\":0,\"eresourceDescription\":null,\"singleBranch\":false,\"metadataId\":\"S114C1786566\",\"availabilityLocationType\":\"NA\",\"statusType\":\"UNAVAILABLE\",\"status\":\"UNAVAILABLE\",\"bibType\":\"PHYSICAL\",\"volumesCount\":0,\"totalCopies\":2,\"libraryUseOnly\":false,\"eresourceUrl\":null,\"availableCopies\":0}},\"S114C1810678\":{\"id\":\"S114C1810678\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"networking_all_in_1_for_dummies�lowe_doug�text_eng\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"genreForm\":[\"Handbooks and Manuals\",\"Handbooks and manuals\"],\"callNumber\":\"004.6 LOW\",\"authors\":[\"Lowe, Doug\"],\"metadataId\":\"S114C1810678\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9781394278381/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9781394278381/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9781394278381/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"multiscriptAuthor\":null,\"audiences\":[\"ADULT\"],\"consumptionFormat\":\"READ\",\"contentType\":\"NONFICTION\",\"multiscriptTitle\":null,\"compositeSubjectHeadings\":[\"Computer Networks\",\"Computer Networks -- Management\",\"Handbooks and Manuals\"],\"series\":[{\"name\":\"--For dummies\",\"volume\":null,\"sortName\":\"--for dummies\",\"volumeNumber\":null}],\"format\":\"BK\",\"subtitle\":\"\",\"title\":\"Networking All-in-one for Dummies\",\"primaryLanguage\":\"eng\",\"publicationDate\":\"2025\",\"id\":\"S114C1810678\",\"description\":\"\\\"The essentials you need to learn about networking--10 books in one! With over 900 pages of clear and trustworthy information, Networking All-in-One For Dummies is the perfect beginner's guide AND the perfect professional reference book. Small networks, large networks, business networks, cloud networks--it's all covered. Learn how to set up a network and keep it functioning, using Windows Server, Linux, and related technologies. This book also covers best practices for security, managing mobile devices, and beyond. Maybe you're just getting started with networking, or maybe you know what you're doing and need a resource with all the knowledge in one place. Either way, you've found what you need with this Dummies All-in-One Plan a network from scratch and learn how to set up all the hardware and software you'll need Find explanations and examples of important networking protocols Build remote and cloud-based networks of various sizes Administer networks with Windows Server and other versions Secure your network with penetration testing and planning for cybersecurity incident responses Every network administrator needs a copy of Networking All-in-One For Dummies, the comprehensive learning resource and reliable desk reference\\\"-- Provided by publisher.\",\"isbns\":[\"9781394278381\",\"1394278381\"],\"rating\":{},\"subjectHeadings\":[\"Computer networks\",\"Computer networks Management\"],\"edition\":\"9th edition\"},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":true,\"materialPolicy\":{\"requiresDuration\":false,\"supportsSuspendHoldStartDateEdit\":false,\"supportsBatchVolumeHolds\":true,\"requiresFormatDuringHold\":false,\"supportsBorrowingHistory\":false,\"borrowingHistorySupportsReturnedDates\":true,\"showQuickstartLink\":false,\"supportsDownload\":false,\"requiresFormatDuringCheckout\":false,\"requiresEmailDuringHold\":false,\"helpUrl\":null,\"externalAPI\":false,\"itemLevelHoldsPredetermined\":false,\"showFormatDuringHold\":false,\"supportsSuspendHold\":false,\"maintainsBorrowingHistoryOnDisable\":false,\"quickStartUrl\":null,\"showFormatDuringCheckout\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"supportsSuspendHoldEndDateEdit\":true,\"supportsCancelledExpiredHolds\":true,\"healthy\":true}},\"availability\":{\"circulationType\":\"REQUEST\",\"onOrderCopies\":0,\"localisedStatus\":\"AVAILABLE_IN_BRANCH\",\"heldCopies\":0,\"eresourceDescription\":null,\"singleBranch\":false,\"metadataId\":\"S114C1810678\",\"availabilityLocationType\":\"OTHER\",\"statusType\":\"AVAILABLE\",\"status\":\"AVAILABLE\",\"bibType\":\"PHYSICAL\",\"volumesCount\":0,\"totalCopies\":3,\"libraryUseOnly\":false,\"eresourceUrl\":null,\"availableCopies\":2}},\"S114C1312885\":{\"id\":\"S114C1312885\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"downsized_veggie_garden_how_to_garden_small_wherever_you_live_whatever_your_space�copsey_kate�text_eng\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"genreForm\":[],\"callNumber\":\"635 COP\",\"authors\":[\"Copsey, Kate\"],\"metadataId\":\"S114C1312885\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9781943366002/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9781943366002/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9781943366002/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"multiscriptAuthor\":null,\"audiences\":[\"ADULT\"],\"consumptionFormat\":\"READ\",\"contentType\":\"NONFICTION\",\"multiscriptTitle\":null,\"compositeSubjectHeadings\":[\"Vegetable Gardening\",\"Small Gardens\"],\"series\":[],\"format\":\"BK\",\"subtitle\":\"How to Garden Small Wherever You Live, Whatever your Space\",\"title\":\"The Downsized Veggie Garden\",\"primaryLanguage\":\"eng\",\"publicationDate\":\"2016\",\"id\":\"S114C1312885\",\"description\":\"Small is beautiful, and integrating a small, easy-to-manage garden into hectic everyday life is easy. In The Downsized Veggie Garden, low maintenance is the mantra. And so is making smart, creative use of the space we have -- whether it's outdoors, indoors, in-ground, in containers, on a balcony railing...or even going vertical. Garden expert Kate Copsey takes the reader season-by-season, plant-by-plant, with essential tips about soil, seed-starting, plant choices, non-chemical fertilizing, watering, choosing the right containers, veggie garden planning and planting, and much more. This fully illustrated book is a one-stop guide for the beginner gardener or the downsizing gardener.\",\"isbns\":[\"9781943366002\",\"1943366004\"],\"rating\":{\"averageRating\":81,\"totalCount\":8},\"subjectHeadings\":[\"Vegetable gardening\",\"Small gardens\"],\"edition\":\"First edition\"},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":false,\"materialPolicy\":{\"requiresDuration\":false,\"supportsSuspendHoldStartDateEdit\":false,\"supportsBatchVolumeHolds\":true,\"requiresFormatDuringHold\":false,\"supportsBorrowingHistory\":false,\"borrowingHistorySupportsReturnedDates\":true,\"showQuickstartLink\":false,\"supportsDownload\":false,\"requiresFormatDuringCheckout\":false,\"requiresEmailDuringHold\":false,\"helpUrl\":null,\"externalAPI\":false,\"itemLevelHoldsPredetermined\":false,\"showFormatDuringHold\":false,\"supportsSuspendHold\":false,\"maintainsBorrowingHistoryOnDisable\":false,\"quickStartUrl\":null,\"showFormatDuringCheckout\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"supportsSuspendHoldEndDateEdit\":true,\"supportsCancelledExpiredHolds\":true,\"healthy\":true}},\"availability\":{\"circulationType\":\"REQUEST\",\"onOrderCopies\":0,\"localisedStatus\":\"UNAVAILABLE\",\"heldCopies\":0,\"eresourceDescription\":null,\"singleBranch\":false,\"metadataId\":\"S114C1312885\",\"availabilityLocationType\":\"NA\",\"statusType\":\"UNAVAILABLE\",\"status\":\"UNAVAILABLE\",\"bibType\":\"PHYSICAL\",\"volumesCount\":0,\"totalCopies\":1,\"libraryUseOnly\":false,\"eresourceUrl\":null,\"availableCopies\":0}},\"S114C1784224\":{\"id\":\"S114C1784224\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"learning_data_science_data_wrangling_exploration_visualization_and_modeling_with_python�lau_sam�text_eng\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"genreForm\":[],\"callNumber\":\"006.312 LAU\",\"authors\":[\"Lau, Sam\"],\"metadataId\":\"S114C1784224\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9781098113001/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9781098113001/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9781098113001/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"multiscriptAuthor\":null,\"audiences\":[\"ADULT\"],\"consumptionFormat\":\"READ\",\"contentType\":\"NONFICTION\",\"multiscriptTitle\":null,\"compositeSubjectHeadings\":[\"Python (Computer Program Language)\",\"Data Mining\",\"Python (Langage De Programmation)\",\"Exploration De Données (Informatique)\",\"Data Mining\",\"Python (Computer Program Language)\"],\"series\":[],\"format\":\"BK\",\"subtitle\":\"Data Wrangling, Exploration, Visualization, and Modeling With Python\",\"title\":\"Learning Data Science\",\"primaryLanguage\":\"eng\",\"publicationDate\":\"2023\",\"id\":\"S114C1784224\",\"description\":\"\\\"As an aspiring data scientist, you appreciate why organizations rely on data for important decisions--whether it's for companies designing websites, cities deciding how to improve services, or scientists discovering how to stop the spread of disease. And you want the skills required to distill a messy pile of data into actionable insights. We call this the data science lifecycle: the process of collecting, wrangling, analyzing, and drawing conclusions from data. [This] is the first book to cover foundational skills in both programming and statistics that encompass this entire lifecycle. It's aimed at those who wish to become data scientists or who already work with data scientists, and at data analysts who wish to cross the 'technical/nontechnical' divide. If you have a basic knowledge of Python programming, you'll learn how to work with data using industry-standard tools like pandas\\\"-- Publisher description.\",\"isbns\":[\"9781098113001\",\"1098113004\"],\"rating\":{},\"subjectHeadings\":[\"Python (Computer program language)\",\"Data mining\",\"Python (Langage de programmation)\",\"Exploration de données (Informatique)\",\"Data mining\",\"Python (Computer program language)\"],\"edition\":\"First edition\"},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":false,\"materialPolicy\":{\"requiresDuration\":false,\"supportsSuspendHoldStartDateEdit\":false,\"supportsBatchVolumeHolds\":true,\"requiresFormatDuringHold\":false,\"supportsBorrowingHistory\":false,\"borrowingHistorySupportsReturnedDates\":true,\"showQuickstartLink\":false,\"supportsDownload\":false,\"requiresFormatDuringCheckout\":false,\"requiresEmailDuringHold\":false,\"helpUrl\":null,\"externalAPI\":false,\"itemLevelHoldsPredetermined\":false,\"showFormatDuringHold\":false,\"supportsSuspendHold\":false,\"maintainsBorrowingHistoryOnDisable\":false,\"quickStartUrl\":null,\"showFormatDuringCheckout\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"supportsSuspendHoldEndDateEdit\":true,\"supportsCancelledExpiredHolds\":true,\"healthy\":true}},\"availability\":{\"circulationType\":\"REQUEST\",\"onOrderCopies\":0,\"localisedStatus\":\"UNAVAILABLE\",\"heldCopies\":0,\"eresourceDescription\":null,\"singleBranch\":false,\"metadataId\":\"S114C1784224\",\"availabilityLocationType\":\"NA\",\"statusType\":\"UNAVAILABLE\",\"status\":\"UNAVAILABLE\",\"bibType\":\"PHYSICAL\",\"volumesCount\":0,\"totalCopies\":1,\"libraryUseOnly\":false,\"eresourceUrl\":null,\"availableCopies\":0}},\"S114C1554468\":{\"id\":\"S114C1554468\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"firewalls_don_t_stop_dragons_a_step_by_step_guide_to_computer_security_for_non_techies�parker_carey�text_eng\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"genreForm\":[],\"callNumber\":\"005.8 PAR\",\"authors\":[\"Parker, Carey\"],\"metadataId\":\"S114C1554468\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9781484238516/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9781484238516/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9781484238516/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"multiscriptAuthor\":null,\"audiences\":[\"ADULT\"],\"consumptionFormat\":\"READ\",\"contentType\":\"NONFICTION\",\"multiscriptTitle\":null,\"compositeSubjectHeadings\":[\"Computer Security\",\"Firewalls (Computer Security)\",\"COMPUTERS -- Security -- General\"],\"series\":[],\"format\":\"BK\",\"subtitle\":\"A Step-by-step Guide to Computer Security for Non-techies\",\"title\":\"Firewalls Don't Stop Dragons\",\"primaryLanguage\":\"eng\",\"publicationDate\":\"2018\",\"id\":\"S114C1554468\",\"description\":\"Just how secure is your computer? Protecting your computer is like defending a medieval castle: moats and castle guards can be effective, but you'd bankrupt the kingdom trying to build something dragon-proof. Parker shows you dozens of no-brainer things we should all be doing to protect our computers and safeguard our data.\",\"isbns\":[\"9781484238516\",\"1484238516\"],\"rating\":{\"averageRating\":100,\"totalCount\":1},\"subjectHeadings\":[\"Computer security\",\"Firewalls (Computer security)\",\"COMPUTERS Security General\"],\"edition\":\"Third edition\"},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":false,\"materialPolicy\":{\"requiresDuration\":false,\"supportsSuspendHoldStartDateEdit\":false,\"supportsBatchVolumeHolds\":true,\"requiresFormatDuringHold\":false,\"supportsBorrowingHistory\":false,\"borrowingHistorySupportsReturnedDates\":true,\"showQuickstartLink\":false,\"supportsDownload\":false,\"requiresFormatDuringCheckout\":false,\"requiresEmailDuringHold\":false,\"helpUrl\":null,\"externalAPI\":false,\"itemLevelHoldsPredetermined\":false,\"showFormatDuringHold\":false,\"supportsSuspendHold\":false,\"maintainsBorrowingHistoryOnDisable\":false,\"quickStartUrl\":null,\"showFormatDuringCheckout\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"supportsSuspendHoldEndDateEdit\":true,\"supportsCancelledExpiredHolds\":true,\"healthy\":true}},\"availability\":{\"circulationType\":\"REQUEST\",\"onOrderCopies\":0,\"localisedStatus\":\"UNAVAILABLE\",\"heldCopies\":0,\"eresourceDescription\":null,\"singleBranch\":false,\"metadataId\":\"S114C1554468\",\"availabilityLocationType\":\"NA\",\"statusType\":\"UNAVAILABLE\",\"status\":\"UNAVAILABLE\",\"bibType\":\"PHYSICAL\",\"volumesCount\":0,\"totalCopies\":1,\"libraryUseOnly\":false,\"eresourceUrl\":null,\"availableCopies\":0}},\"S114C1755945\":{\"id\":\"S114C1755945\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"what_child_is_this_a_sherlock_holmes_christmas_adventure�macbird_bonnie�text_eng\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"genreForm\":[\"Detective and mystery fiction\",\"Christmas Fiction\",\"Detective and Mystery Fiction\",\"Fiction\",\"Christmas fiction\"],\"callNumber\":\"MACBIRD, B\",\"authors\":[\"MacBird, Bonnie\"],\"metadataId\":\"S114C1755945\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9780008521318/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9780008521318/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9780008521318/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"multiscriptAuthor\":null,\"audiences\":[\"ADULT\"],\"consumptionFormat\":\"READ\",\"contentType\":\"FICTION\",\"multiscriptTitle\":null,\"compositeSubjectHeadings\":[\"Holmes, Sherlock -- Fiction\",\"Watson, John H. (Fictitious Character) -- Fiction\",\"Private Investigators -- England -- London -- Fiction\",\"Kidnapping -- Fiction\",\"Missing Persons -- Fiction\",\"Detective and Mystery Fiction\",\"Christmas Fiction\"],\"series\":[{\"name\":\"Sherlock Holmes adventure\",\"volume\":null,\"sortName\":\"sherlock holmes adventure\",\"volumeNumber\":null}],\"format\":\"BK\",\"subtitle\":\"A Sherlock Holmes Christmas Adventure\",\"title\":\"What Child Is This?\",\"primaryLanguage\":\"eng\",\"publicationDate\":\"2022\",\"id\":\"S114C1755945\",\"description\":\"It's the season of peace and goodwill, but a Victorian Christmas is no holiday for the world's most popular detective in this new book from Bonnie MacBird, author of the bestselling Sherlock Holmes novel Art in the Blood. It's Christmastime in London, and Sherlock Holmes takes on two cases. The angelic three-year-old child of a wealthy couple is the target of a vicious kidnapper, and a country aristocrat worries that his handsome, favourite son has mysteriously vanished from his London pied à terre. Holmes and Watson, aided by the colourful Heffie O'Malley, slip slide in the ice to ensure a merry Christmas is had by nearly everybody.\",\"isbns\":[\"9780008521318\",\"000852131X\",\"9780008521288\",\"000852128X\"],\"rating\":{},\"subjectHeadings\":[\"Holmes, Sherlock Fiction\",\"Watson, John H. (Fictitious character) Fiction\",\"Private investigators England London Fiction\",\"Kidnapping Fiction\",\"Missing persons Fiction\"],\"edition\":null},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":false,\"materialPolicy\":{\"requiresDuration\":false,\"supportsSuspendHoldStartDateEdit\":false,\"supportsBatchVolumeHolds\":true,\"requiresFormatDuringHold\":false,\"supportsBorrowingHistory\":false,\"borrowingHistorySupportsReturnedDates\":true,\"showQuickstartLink\":false,\"supportsDownload\":false,\"requiresFormatDuringCheckout\":false,\"requiresEmailDuringHold\":false,\"helpUrl\":null,\"externalAPI\":false,\"itemLevelHoldsPredetermined\":false,\"showFormatDuringHold\":false,\"supportsSuspendHold\":false,\"maintainsBorrowingHistoryOnDisable\":false,\"quickStartUrl\":null,\"showFormatDuringCheckout\":false,\"supportsFastAvailability\":false,\"supportsReadNow\":false,\"supportsSuspendHoldEndDateEdit\":true,\"supportsCancelledExpiredHolds\":true,\"healthy\":true}},\"availability\":{\"circulationType\":\"REQUEST\",\"onOrderCopies\":0,\"localisedStatus\":\"AVAILABLE_IN_BRANCH\",\"heldCopies\":0,\"eresourceDescription\":null,\"singleBranch\":false,\"metadataId\":\"S114C1755945\",\"availabilityLocationType\":\"OTHER\",\"statusType\":\"AVAILABLE\",\"status\":\"AVAILABLE\",\"bibType\":\"PHYSICAL\",\"volumesCount\":0,\"totalCopies\":3,\"libraryUseOnly\":false,\"eresourceUrl\":null,\"availableCopies\":1}},\"S114C1554503\":{\"id\":\"S114C1554503\",\"sourceLibId\":114,\"briefInfo\":{\"groupKey\":\"linux_basics_for_hackers_getting_started_with_networking_scripting_and_security_in_kali�occupytheweb�text_eng\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"genreForm\":[],\"callNumber\":\"005.8 OCC\",\"authors\":[\"OccupyTheWeb\"],\"metadat
leBranch\":false,\"statusType\":\"UNAVAILABLE\"}},\"S114C1813549\":{\"id\":\"S114C1813549\",\"sourceLibId\":114,\"briefInfo\":{\"metadataId\":\"S114C1813549\",\"title\":\"Cybersecurity Tabletop Exercises\",\"subtitle\":\"From Planning to Execution\",\"format\":\"BK\",\"superFormats\":[\"BOOKS\",\"MODERN_FORMATS\"],\"consumptionFormat\":\"READ\",\"callNumber\":\"005.8 LEL\",\"description\":\"\\\"Provides detailed guidance on how to plan, facilitate, and learn from a cybersecurity tabletop exercise so that members of an organization can coordinate their response to a potential future cybersecurity event or emergency. Includes examples of tabletop exercise scenarios suited to different purposes\\\"-- Provided by publisher.\",\"genreForm\":[],\"subjectHeadings\":[\"Computer security Decision making\",\"Computer security Planning\"],\"authors\":[\"Lelewski, Robert\"],\"publicationDate\":\"2025\",\"jacket\":{\"type\":\"SYNDETICS\",\"small\":\"https://secure.syndetics.com/index.aspx?isbn=9781718503823/SC.GIF&client=dougp&type=xw12&oclc=\",\"medium\":\"https://secure.syndetics.com/index.aspx?isbn=9781718503823/MC.GIF&client=dougp&type=xw12&oclc=\",\"large\":\"https://secure.syndetics.com/index.aspx?isbn=9781718503823/LC.JPG&client=dougp&type=xw12&oclc=\",\"local_url\":null},\"isbns\":[\"9781718503823\",\"9781718503830\"],\"primaryLanguage\":\"eng\",\"series\":[],\"edition\":null,\"multiscriptTitle\":null,\"multiscriptAuthor\":null,\"contentType\":\"NONFICTION\",\"audiences\":[\"ADULT\"],\"compositeSubjectHeadings\":[\"Computer Security -- Decision Making\",\"Computer Security -- Planning\"],\"groupKey\":\"cybersecurity_tabletop_exercises_from_planning_to_execution�lelewski_robert�text_eng\",\"id\":\"S114C1813549\",\"rating\":{}},\"policy\":{\"materialType\":\"PHYSICAL\",\"provider\":\"ILS\",\"holdable\":true,\"itemLevelHoldableItems\":false,\"materialPolicy\":{\"supportsBatchVolumeHolds\":true,\"itemLevelHoldsPredetermined\":false,\"requiresDuration\":false,\"requiresEmailD